#include <behaviors.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define MOUSE 1
#define SYM 2
#define NUM 3
#define NAV 4
#define FN 5
#define SYS 6
#define SCROLL 7

// 文字入力を優先し、200 ms以上の長押しでレイヤーを切り替える。
&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <0>;
};

// 自動マウスはZMK標準のInput Processorで制御する。
&trackball {
    automouse-layer = <0>;
    scroll-layers = <SCROLL>;
};

// 手動レイヤーの優先順を保ち、入力が止まって700 ms後にMOUSEを解除する。
&trackball_listener {
    input-processors = <&zip_temp_layer MOUSE 700>;
};

&zip_temp_layer {
    // 文字入力の直後は、ボールに触れてもMOUSEを新たに有効にしない。
    require-prior-idle-ms = <300>;
    // 0始まりのキー位置。J/K/L、Shift、スクロール、Ctrl/Win/Altでは解除しない。
    excluded-positions = <18 19 20 27 28 34 35 36>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
                &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P
                &kp A  &kp S  &kp D  &kp F  &kp G  &kp TAB  &kp ESC  &kp H  &kp J  &kp K  &kp L  &kp MINUS
                &kp Z  &kp X  &kp C  &kp V  &kp B  &kp LSHIFT  &mo SCROLL  &kp N  &kp M  &kp COMMA  &kp DOT  &kp SLASH
                &kp LCTRL  &kp LGUI  &kp LALT  &lt NUM LANG2  &kp SPACE  &lt SYM LANG1  &lt NAV BSPC  &kp ENTER  &kp DEL
            >;
        };

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        sym_layer {
            display-name = "SYM";
            bindings = <
                &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp CARET  &kp AMPS  &kp ASTERISK  &kp LPAR  &kp RPAR
                &kp GRAVE  &kp SEMI  &kp COLON  &kp SQT  &kp DQT  &trans  &trans  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BACKSLASH
                &kp TILDE  &kp LT  &kp GT  &kp SLASH  &kp QMARK  &trans  &trans  &kp UNDER  &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        num_layer {
            display-name = "NUM";
            bindings = <
                &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
                &none  &none  &none  &none  &none  &mo SYS  &mo FN  &none  &none  &none  &none  &none
                &none  &none  &none  &none  &none  &trans  &trans  &none  &none  &none  &none  &none
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
                &kp HOME  &kp UP  &kp END  &kp PG_UP  &kp LC(HOME)  &none  &none  &none  &none  &none
                &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_DN  &kp LC(END)  &trans  &trans  &none  &none  &none  &none  &none
                &none  &kp LC(LEFT)  &kp DEL  &kp LC(RIGHT)  &kp LC(BSPC)  &trans  &trans  &none  &none  &none  &none  &none
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        fn_layer {
            display-name = "FN";
            bindings = <
                &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
                &kp F11  &kp F12  &none  &none  &none  &trans  &trans  &none  &none  &none  &none  &none
                &none  &none  &none  &none  &none  &trans  &trans  &none  &none  &none  &none  &none
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        sys_layer {
            display-name = "SYS";
            bindings = <
                &none  &none  &none  &none  &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
                &none  &none  &none  &none  &none  &trans  &trans  &none  &none  &none  &none  &none
                &none  &none  &none  &none  &none  &trans  &bootloader  &none  &none  &none  &none  &none
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_CLR
            >;
        };

        scroll_layer {
            display-name = "SCROLL";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
